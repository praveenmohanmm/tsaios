<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- HealthKit entitlement — required for HKWorkoutSession.
         An active HKWorkoutSession keeps WCSession.isReachable = true on the
         iPhone even when the Watch display is off / locked, enabling instant
         haptic delivery via sendMessage for the full session duration. -->
    <key>com.apple.developer.healthkit</key>
    <true/>
</dict>
</plist>
